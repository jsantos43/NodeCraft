{
  "owner": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "ownerId"
          ],
          "properties": {
            "ownerId": {
              "type": "string",
              "format": "uuid",
              "example": "1e7ca2e6-519d-45af-ba5f-18305979ac8b"
            }
          }
        }
      }
    }
  },
  "worker": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "workerId"
          ],
          "properties": {
            "workerId": {
              "type": "string",
              "format": "uuid",
              "nullable": true,
              "example": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f"
            }
          }
        }
      }
    }
  },
  "create": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "description": "Creates an instance. workerId is mandatory and must be one of the user's allowedWorkers. game is required and validated according to type; {} uses the game defaults. Unknown game properties are discarded. Server-controlled fields such as port, status and history are rejected.",
          "required": [
            "name",
            "type",
            "workerId",
            "game"
          ],
          "properties": {
            "name": {
              "type": "string",
              "example": "Meu mundo de minecraft",
              "minLength": 3,
              "maxLength": 32
            },
            "type": {
              "type": "string",
              "enum": [
                "minecraft",
                "hytale",
                "terraria",
                "kerbal"
              ],
              "example": "minecraft"
            },
            "workerId": {
              "type": "string",
              "description": "Worker to place the instance on. Must be one of the user's allowedWorkers.",
              "example": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "format": "uuid"
            },
            "memory": {
              "type": "integer",
              "minimum": 512,
              "example": 2048
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "example": 2
            },
            "maxPlayers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "example": 10
            },
            "game": {
              "type": "object",
              "description": "Settings validated using the schema selected by type. Empty objects are accepted; unknown game properties are discarded."
            }
          },
          "oneOf": [
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "minecraft"
                  ]
                },
                "game": {
                  "$ref": "../schemas/minecraft.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "hytale"
                  ]
                },
                "game": {
                  "$ref": "../schemas/hytale.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "kerbal"
                  ]
                },
                "game": {
                  "$ref": "../schemas/kerbal.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "terraria"
                  ]
                },
                "game": {
                  "$ref": "../schemas/terraria.json"
                }
              }
            }
          ]
        },
        "examples": {
          "minecraft": {
            "value": {
              "name": "My server",
              "workerId": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "type": "minecraft",
              "game": {}
            }
          },
          "hytale": {
            "value": {
              "name": "My server",
              "workerId": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "type": "hytale",
              "game": {}
            }
          },
          "kerbal": {
            "value": {
              "name": "My server",
              "workerId": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "type": "kerbal",
              "game": {}
            }
          },
          "terraria": {
            "value": {
              "name": "My server",
              "workerId": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "type": "terraria",
              "game": {}
            }
          }
        }
      }
    }
  },
  "update": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "description": "Updates a stopped instance. Supply at least one of name, memory, cpu, maxPlayers or game. game requires type, but type does not require game. When supplied, type must equal the persisted instance type or the request returns 400 without changes. type is never persisted. Unknown game properties are discarded. To change workerId, use PUT /instance/{id}/worker (admin).",
          "properties": {
            "name": {
              "type": "string",
              "example": "Meu mundo de minecraft",
              "minLength": 3,
              "maxLength": 32
            },
            "type": {
              "type": "string",
              "enum": [
                "minecraft",
                "hytale",
                "terraria",
                "kerbal"
              ],
              "example": "minecraft",
              "description": "Must equal the persisted instance type. Required when game is supplied; optional for updates of instance fields. Cannot change the game of an instance."
            },
            "memory": {
              "type": "integer",
              "minimum": 512,
              "example": 2048
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "example": 2
            },
            "maxPlayers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "example": 10
            },
            "game": {
              "type": "object",
              "description": "Settings validated using the schema selected by type. Empty objects are accepted; unknown game properties are discarded."
            }
          },
          "oneOf": [
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "minecraft"
                  ]
                },
                "game": {
                  "$ref": "../schemas/minecraft.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "hytale"
                  ]
                },
                "game": {
                  "$ref": "../schemas/hytale.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "kerbal"
                  ]
                },
                "game": {
                  "$ref": "../schemas/kerbal.json"
                }
              }
            },
            {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "terraria"
                  ]
                },
                "game": {
                  "$ref": "../schemas/terraria.json"
                }
              }
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "type"
                    ]
                  },
                  {
                    "required": [
                      "game"
                    ]
                  }
                ]
              }
            }
          ],
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "memory"
              ]
            },
            {
              "required": [
                "cpu"
              ]
            },
            {
              "required": [
                "maxPlayers"
              ]
            },
            {
              "required": [
                "game"
              ]
            }
          ]
        },
        "examples": {
          "minecraft": {
            "value": {
              "type": "minecraft",
              "game": {}
            }
          },
          "hytale": {
            "value": {
              "type": "hytale",
              "game": {}
            }
          },
          "kerbal": {
            "value": {
              "type": "kerbal",
              "game": {}
            }
          },
          "terraria": {
            "value": {
              "type": "terraria",
              "game": {}
            }
          },
          "instanceOnly": {
            "value": {
              "name": "My server"
            }
          },
          "typedInstanceOnly": {
            "value": {
              "name": "My server",
              "type": "minecraft"
            }
          }
        }
      }
    }
  }
}
