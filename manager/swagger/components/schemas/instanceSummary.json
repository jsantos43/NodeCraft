{
  "type": "object",
  "additionalProperties": false,
  "description": "Basic instance summary, available to owners, admins and linked accounts.",
  "properties": {
    "id": {
      "type": "string",
      "example": "76ad39e5-827f-4e0f-9715-e590be710595"
    },
    "workerId": {
      "type": "string",
      "nullable": true,
      "example": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f"
    },
    "ownerId": {
      "type": "string",
      "example": "1e7ca2e6-519d-45af-ba5f-18305979ac8b"
    },
    "name": {
      "type": "string",
      "example": "Meu mundo de minecraft"
    },
    "type": {
      "type": "string",
      "example": "minecraft"
    },
    "port": {
      "type": "number",
      "example": 5634
    },
    "memory": {
      "type": "integer",
      "example": 2048
    },
    "cpu": {
      "type": "integer",
      "example": 2
    },
    "maxPlayers": {
      "type": "integer",
      "example": 10
    },
    "diskUsage": {
      "type": "integer",
      "description": "Current disk usage of the instance in MB.",
      "example": 512
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "stopped",
        "failed"
      ],
      "example": "stopped"
    },
    "lastActivityAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "example": "2026-07-17T02:45:00.000Z"
    },
    "lastBackupAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "example": "2026-07-17T03:00:00.000Z",
      "description": "When the last backup finished (the worker reported its result). Null until one completes."
    },
    "backupRequestedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the scheduler last asked a worker to back this instance up. Stamped at request time, so it moves ahead of lastBackupAt while a backup is in flight; the nightly run uses it to avoid triggering the same instance twice.",
      "example": "2026-07-17T03:00:00.000Z"
    },
    "lastBackupStatus": {
      "type": "string",
      "nullable": true,
      "enum": [
        "success",
        "failed",
        "skipped"
      ],
      "example": "success"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the record was created. Null for rows that predate the column (migration 20260830120000).",
      "example": "2026-07-17T02:45:00.000Z"
    },
    "worker": {
      "type": "object",
      "nullable": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "healthy": {
          "type": "boolean"
        }
      },
      "description": "Public worker identity and connection address; excludes credentials."
    }
  },
  "example": {
    "id": "76ad39e5-827f-4e0f-9715-e590be710595",
    "workerId": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
    "ownerId": "1e7ca2e6-519d-45af-ba5f-18305979ac8b",
    "name": "Meu mundo de minecraft",
    "type": "minecraft",
    "port": 5634,
    "memory": 2048,
    "cpu": 2,
    "maxPlayers": 10,
    "diskUsage": 512,
    "status": "stopped",
    "lastActivityAt": "2026-07-17T02:45:00.000Z",
    "lastBackupAt": "2026-07-17T03:00:00.000Z",
    "backupRequestedAt": "2026-07-17T03:00:00.000Z",
    "lastBackupStatus": "success",
    "createdAt": "2026-07-17T02:45:00.000Z"
  }
}
