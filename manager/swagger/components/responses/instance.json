{
  "default": {
    "description": "Instance response filtered by effective permissions: console history, game configuration, roster and sharing details are conditional. Basic connection information and full configuration of every game remain available to linked users; editing requires instance:edit.",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "instance": {
              "$ref": "../schemas/instance.json"
            }
          }
        }
      }
    }
  },
  "permissions": {
    "description": "OK",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "instance:read",
                "instance:console:read",
                "instance:console:write",
                "instance:owner"
              ]
            }
          }
        }
      }
    }
  },
  "console": {
    "description": "OK",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "token": {
              "type": "string",
              "description": "Short-lived (120s) JWT used to authenticate the console WebSocket on the worker.",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            },
            "workerUrl": {
              "type": "string",
              "example": "http://worker.webisk.com.br:9184"
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "console:read",
                "console:write"
              ]
            }
          }
        }
      }
    }
  },
  "readAll": {
    "description": "OK",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "instances": {
              "type": "array",
              "items": {
                "$ref": "../schemas/instanceSummary.json"
              }
            }
          }
        },
        "examples": {
          "many Instances": {
            "value": {
              "success": true,
              "instances": [
                {
                  "id": "76ad39e5-827f-4e0f-9715-e590be710595",
