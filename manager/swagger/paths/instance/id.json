{
  "get": {
    "summary": "read a Instance",
    "description": "Reads a single instance with its game-specific config and linked players. Requires the `instance:read` permission.",
    "tags": [
      "Instance"
    ],
    "responses": {
      "200": {
        "$ref": "../../components/responses/instance.json#/default"
      },
      "400": {
        "$ref": "../../components/responses/error.json#/InvalidRequest"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "403": {
        "$ref": "../../components/responses/error.json#/Forbidden"
      },
      "404": {
        "$ref": "../../components/responses/error.json#/NotFound"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      }
    }
  },
  "put": {
    "summary": "update a Instance",
    "description": "Updates the instance settings (name, memory, cpu, maxPlayers and the game-specific `game` block). The instance must be stopped. Requires the `instance:edit` permission. When memory or CPU is supplied, the resulting instance configuration must fit the owner's individual memory and CPU quotas, otherwise returns 403. Aggregate memory and CPU quotas are checked when starting or restarting instances.",
    "tags": [
      "Instance"
    ],
    "responses": {
      "200": {
        "$ref": "../../components/responses/instance.json#/default"
      },
      "400": {
        "$ref": "../../components/responses/error.json#/InvalidRequest"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "403": {
        "$ref": "../../components/responses/error.json#/Forbidden"
      },
      "404": {
        "$ref": "../../components/responses/error.json#/NotFound"
      },
      "413": {
        "$ref": "../../components/responses/error.json#/PayloadTooLarge"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      }
    },
    "requestBody": {
      "$ref": "../../components/requestBody/instance.json#/update"
    }
  },
  "delete": {
    "summary": "delete a Instance",
    "description": "Permanently deletes the instance. The instance must be stopped. Requires being the instance owner (`instance:owner`).",
    "tags": [
      "Instance"
    ],
    "responses": {
      "200": {
        "$ref": "../../components/responses/instance.json#/default"
      },
      "400": {
        "$ref": "../../components/responses/error.json#/InvalidRequest"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "403": {
        "$ref": "../../components/responses/error.json#/Forbidden"
      },
      "404": {
        "$ref": "../../components/responses/error.json#/NotFound"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      }
    }
  },
  "parameters": [
    {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "example": "76ad39e5-827f-4e0f-9715-e590be710595"
    }
  ]
