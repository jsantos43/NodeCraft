{
  "post": {
    "summary": "upload File",
    "description": "Uploads a file (multipart/form-data) into the instance game folder at `destiny`. Streamed through to the worker. Requires `instance:files:write`. Worker communication failures return 503 before the response starts. A timeout does not confirm failure of the operation: check its resulting state before retrying. No automatic retry is performed. File uploads/downloads retain the streaming flow without an application-level timeout or inactivity timer. Non-download JSON reads use WORKER_TIMEOUT (default 300000 ms), including response body consumption.",
    "tags": [
      "Files"
    ],
    "parameters": [
      {
        "name": "destiny",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "world.zip"
      }
    ],
    "responses": {
      "201": {
        "$ref": "../../components/responses/file.json#/upload"
      },
      "400": {
        "$ref": "../../components/responses/error.json#/InvalidRequest"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "403": {
        "$ref": "../../components/responses/error.json#/Forbidden"
      },
      "404": {
        "$ref": "../../components/responses/error.json#/NotFound"
      },
      "413": {
        "$ref": "../../components/responses/error.json#/PayloadTooLarge"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      },
      "503": {
        "$ref": "../../components/responses/error.json#/UnavailableService"
      }
    },
    "requestBody": {
      "$ref": "../../components/requestBody/file.json#/upload"
    }
  },
  "parameters": [
    {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "example": "76ad39e5-827f-4e0f-9715-e590be710595"
    }
  ]
}
