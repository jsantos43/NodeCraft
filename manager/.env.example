# App
# PORT — HTTP port the manager listens on (default 9183)
# STAGE — set to DEV for local development; anything else (or unset) means production.
# GMT — hour offset applied to scheduled jobs (the nightly backup runs at 3AM local time)
# LOG_LEVEL — pino level: trace|debug|info|warn|error|fatal|silent (default info).
PORT=9183
STAGE=PROD
GMT=-3
LOG_LEVEL=

# Frontend URLs
# SITE_URL — base URL of the web frontend (default http://localhost:3030)
# CORS_ORIGIN — comma-separated allowed origins, exact match, no wildcards (default SITE_URL)
SITE_URL=
CORS_ORIGIN=
# API_BASE_PATH — prefix the reverse proxy publishes this API under, as the
#   browser sees it; use "/" when it is served at the root. Only used to scope
#   the refreshToken cookie. Defaults to "" in dev and "/api" otherwise.
API_BASE_PATH=

# Database
# DATABASE_ENABLE — must be the literal string "true" to use MySQL; otherwise SQLite.
# DATABASE_POOL_MAX — max connections in the Sequelize pool (default 20)
# DATABASE_POOL_ACQUIRE — ms to wait for a free connection before failing (default 20000)
# DATABASE_LOCK_WAIT_TIMEOUT — innodb_lock_wait_timeout, in SECONDS (default 10)
DATABASE_ENABLE=
DATABASE_HOST=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_POOL_MAX=
DATABASE_POOL_ACQUIRE=
DATABASE_LOCK_WAIT_TIMEOUT=

# Email (account verification and password reset)
# EMAIL_ENABLE / EMAIL_SECURE — must be the literal string "true" to enable
# EMAIL_FROM_ADDRESS — sender email, separate from SMTP login; defaults to EMAIL_USER.
#   Required when the login is not an email (e.g. EMAIL_USER=resend).
EMAIL_ENABLE=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=

# Auth
# JWT_SECRET — secret used to sign access tokens.
JWT_SECRET=

# Instances
# MAX_HISTORY — status lines kept per instance; older ones are dropped (default 50)
# MIN_PORT / MAX_PORT — host port range allocated to instances (default 5621–5671)
MAX_HISTORY=50
MIN_PORT=5621
MAX_PORT=5671

# WORKER_TIMEOUT — timeout in ms of every manager
WORKER_TIMEOUT=15000

# Rate limiting (unauthenticated routes, per client IP)
# RATE_LIMIT_WINDOW — window in ms that the counters below apply to (default 15min)
# RATE_LIMIT_LOGIN — failed login/refresh/reset attempts per window (default 10);
# RATE_LIMIT_CREATE_ACCOUNT — account signups per window (default 5)
# RATE_LIMIT_EMAIL — mail-sending requests (verify, forgot password) per window (default 3)
# TRUST_PROXY — proxy hops in front of the manager, for resolving the real client IP
#   (default 0). Set to 1 behind a single nginx/cloudflare; leaving it at 0 while
#   proxied puts every client in one bucket. Never set it above the hops you control.
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CREATE_ACCOUNT=5
RATE_LIMIT_EMAIL=3
TRUST_PROXY=0
